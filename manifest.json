{
  "manifest_version": 3,
  "name": "网页分区截图插件",
  "version": "1.0.0",
  "description": "通过 Photoshop 风格的标尺栏手动框选网页多个部分，并将每个部分保存为 PNG 图片。",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/constants.js",
        "content/Storage.js",
        "content/BackgroundService.js",
        "content/modules/Naming.js",
        "content/modules/ProgressModal.js",
        "content/modules/Ruler.js",
        "content/modules/GuideManager.js",
        "content/modules/ScreenshotManager.js",
        "content/modules/Toolbar.js",
        "content/index.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "网页分区截图插件",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/style.css",
        "lib/html-to-image.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
